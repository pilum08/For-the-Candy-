extends Resource
class_name SpawnEntry
## ЗАПИСЬ ТАБЛИЦЫ СПАВНА (SpawnTable): кого поставить и с каким весом.
##
## КЕМ ЗАДАН МОБ — одно из двух:
##   * mob_scene — готовая сцена врага (Enemy.tscn, Enemy_green.tscn). Она главнее:
##     если задана и сцена, и паспорт, ставится сцена, а паспорт — только для справки.
##   * mob_data  — паспорт вида (MobRigData: enemy_yellow.tres). Тогда берётся сцена-прототип
##     из MobSpawner.prototype_scene (по умолчанию Enemy.tscn) и её узел Visual пересобирается
##     под этот паспорт. Годится, когда у моба своя только внешность, а сцена и поведение общие.
##
## ВЕС (weight) — «частота относительно других записей»: шанс записи = weight / сумма весов
## всех годных записей таблицы. 0 или меньше — запись не выпадает вообще.
## Пример: жёлтый 3.0, зелёный 1.0 → жёлтый появится в 3 раза чаще.
##
## class_name стоит намеренно: по нему таблица объявляет возврат pick() -> SpawnEntry, а
## MobRigData и MobVisual классов не объявляют — они подключаются preload-константой.

const MobRigData := preload("res://MobRigData.gd")   # тип паспорта (нужен только для типов)

# ============================================================================
# КОГО СТАВИТЬ
# ============================================================================
## Сцена врага целиком (со своим поведением и своими экспортами). Пусто — смотрим mob_data.
@export var mob_scene: PackedScene
## Паспорт вида для общей сцены-прототипа (см. MobSpawner.prototype_scene). Пусто — смотрим mob_scene.
@export var mob_data: MobRigData

@export_group("Вес")
## Чем больше, тем чаще выпадает (см. шапку). 0 и меньше — запись не участвует в жребии.
@export var weight: float = 1.0


## Есть ли чем заспавнить: сцена или паспорт. Записи без того и другого жребий пропускает.
func is_usable() -> bool:
	return mob_scene != null or mob_data != null
