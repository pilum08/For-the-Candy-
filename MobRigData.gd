extends Resource
## ПАСПОРТ МОБА: из чего моб собран, как он ходит и стоит, какие у него лица и труп.
## Один .tres = один вид моба (пример: enemy_yellow.tres — жёлтый враг).
##
## В паспорте только данные: числа и пути к PNG, поведения тут нет. Дерево суставов
## и анимацию по паспорту собирает MobVisual.gd, а поведение (погоня, удар касанием,
## прыжок, дальний бой) пишет скрипт врага — см. Enemy.gd.
##
## ЧАСТИ (parts) — список словарей; порядок в списке = порядок отрисовки (дети поверх
## родителей, части из списка — поверх созданных раньше):
##   "name"       — имя части. Из него же делаются ключи поз: Body → body_pos/body_rot,
##                  ArmL → arm_l_pos/arm_l_rot (CamelCase → snake_case).
##                  Имена уникальны; родитель обязан стоять ВЫШЕ в списке.
##   "texture"    — PNG части от res://. "" = часть без картинки: чистый сустав,
##                  к которому крепятся другие части (так сделан корневой Body).
##   "parent"     — имя родительской части; "" = корень моба (сам узел MobVisual).
##   "attach_pos" — куда сустав встаёт НА РОДИТЕЛЕ, пиксели арта (до art_scale).
##   "pivot_px"   — точка сустава ВНУТРИ картинки, пиксели от её левого верхнего угла.
##                  MobVisual ставит centered = false и offset = -pivot_px, поэтому
##                  обрезка краёв PNG на вид не влияет: сменил картинку — правь pivot_px.
##   "z_index"    — порядок отрисовки внутри родителя (не задан = 0).
## Начало координат моба — центр между стопами на земле.
##
## ПОЗЫ (walk_poses / idle_poses) — массивы словарей. В кадре по каждой части задаются
## "<ключ>_pos" (смещение, пиксели арта) и "<ключ>_rot" (поворот, градусы, + = по часовой
## стрелке); не заданный ключ = 0, и сустав остаётся на своём attach_pos.
## pose_fps / idle_pose_fps — частота смены кадров (кадров в секунду): смена рывковая,
## как в стоп-моушене, плавных переходов между кадрами нет.
##
## ЛИЦА (face_idle / face_damage) — картинки для части Face: MobVisual возвращает её к
## face_idle и на время подменяет на face_damage, когда моб получает урон (см.
## MobVisual.flash_damage_face). Пусто — лицо не подменяется.
##
## ТРУП (corpse_texture) — картинка для Corpse.tscn; масштаб трупа = art_scale.
##
## КАК СОЗДАТЬ НОВОГО МОБА:
##   1. Нарежь арт на PNG (тело, штаны, руки, ноги, голова, лицо, при желании труп) в
##      свою папку, например res://Sprites/enemy_green/. Размеры картинок значения не
##      имеют: сустав задаётся точкой внутри картинки (pivot_px).
##   2. Точки суставов берутся один раз и удобнее всего — в редакторе: скопируй
##      enemy_yellow.tres, скопируй Enemy.tscn в черновую сцену, временно добавь туда
##      обычные Sprite2D (centered = true), выставь их как на эталонном арте и перенеси
##      числа: position → attach_pos, центр картинки → pivot_px.
##   3. Правь в своём .tres parts (пути к PNG и оба числа), art_scale, walk_poses,
##      idle_poses, pose_fps, face_idle, face_damage, corpse_texture.
##   4. Скопируй Enemy.tscn (например Enemy_green.tscn) и укажи свой .tres в узле Visual
##      (поле rig). Больше в виде менять нечего — узлов частей в сцене нет.
##   5. Труп: скопируй Corpse.tscn (Corpse_green.tscn), укажи свой .tres в поле mob_rig
##      (текстура и масштаб берутся оттуда) и поставь эту сцену в corpse_scene врага.
##   6. Поведение: если нужны прыжок, дальний бой, другой урон — сделай скрипт-наследник
##      (extends "res://Enemy.gd") и поставь его корню Enemy_green.tscn. Код вида
##      (дерево, позы ходьбы и покоя, лица) писать не надо — это делает MobVisual,
##      а из Enemy для своих нужд доступны rig() (паспорт) и part("ArmR") (сустав части).
##
## class_name намеренно НЕ ставим (как у Rig.gd и ProjectileData.gd), чтобы не зависеть
## от кэша глобальных классов редактора. Тип берётся через
## const MobRigData := preload("res://MobRigData.gd").

@export_group("Сборка")
## Список частей (формат — в шапке файла). Порядок частей = порядок отрисовки.
@export var parts: Array = []
## Общий размер моба: 1.0 = пиксель в пиксель (жёлтый враг нарисован ~725 px высотой),
## 0.21 = примерно как герой. Применяется к узлу MobVisual и — числом в коде врага —
## к его коллизиям, но НЕ к CharacterBody2D (иначе поехала бы физика).
@export_range(0.05, 2.0, 0.01) var art_scale: float = 0.21

@export_group("Позы")
## Кадры бега (обычно 3): массив словарей "<ключ>_pos" / "<ключ>_rot" по частям.
@export var walk_poses: Array = []
## Кадры покоя (обычно 2, медленнее и мягче бега).
@export var idle_poses: Array = []
## Частота смены кадров бега, кадров в секунду.
@export var pose_fps: float = 7.0
## Частота смены кадров покоя, кадров в секунду.
@export var idle_pose_fps: float = 2.0

@export_group("Лица")
## Лицо покоя (часть Face) — показывается обычно.
@export_file("*.png") var face_idle: String = ""
## Лицо урона (часть Face) — подменяет покой, когда моб получает попадание.
@export_file("*.png") var face_damage: String = ""

@export_group("Труп")
## Картинка трупа для Corpse.tscn. Пусто — труп рисует картинку из своей сцены.
@export_file("*.png") var corpse_texture: String = ""
