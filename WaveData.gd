extends Resource
class_name WaveData
## ПАСПОРТ ВОЛНЫ (WaveData) для менеджера волн (WaveManager).
##
## ЧТО ЗА ЧЕМ:
##   mob_count      — сколько мобов поставить за волну;
##   spawn_interval — пауза между появлениями, сек (0 — поставить всех разом);
##   max_alive      — потолок живых мобов ЭТОЙ волны одновременно (0 — без потолка);
##   pause_after    — пауза после волны, сек (перед следующей);
##   spawn_table    — своя таблица мобов; пусто — общая таблица менеджера.
##
## Первую волну менеджер ждёт не pause_after, а WaveManager.first_wave_delay: pause_after —
## это пауза ЗА волной, а перед первой волной ничего ещё не было.
##
## class_name стоит намеренно: по нему менеджер объявляет @export Array[WaveData] — инспектор
## узла WaveManager видит тип элементов. Сами волны лежат отдельными файлами-ресурсами
## (wave_1.tres, wave_2.tres, wave_3.tres), ссылки на них — на узле WaveManager в main.tscn.

# ============================================================================
# МОБЫ
# ============================================================================
## Сколько мобов поставить за волну.
@export var mob_count: int = 4
## Пауза между появлениями, сек. 0 — поставить всех разом.
@export var spawn_interval: float = 1.5
## Сколько мобов этой волны может быть живо одновременно (0 — без ограничения).
## Мобы, поставленные вручную (тестовая клавиша спавнера), в счёт не входят.
@export var max_alive: int = 0

# ============================================================================
# ПАУЗА
# ============================================================================
## Пауза после волны, сек: сначала она, потом следующая волна. У последней волны не играет.
@export var pause_after: float = 4.0

# ============================================================================
# ТАБЛИЦА
# ============================================================================
## Своя таблица спавна этой волны. Пусто — общая таблица менеджера (WaveManager.common_table).
@export var spawn_table: SpawnTable
