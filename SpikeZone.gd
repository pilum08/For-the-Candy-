extends Area2D
## ШИПЫ: касание = смерть героя. Своей логики смерти у зоны нет — она только зовёт
## Player.die(), поэтому респаун и будущая сцена смерти живут в одном месте (Player.gd).
##
## Как ставить: инстанс сцены SpikeZone.tscn в уровень; узел Shape задаёт «лезвия»
## (можешь растянуть/повернуть), узел Visual — заглушка серым, меняй на картинку.
## Слои: зона на слое 0, маска 1 — значит видит только героя (слой «игрок») и никого
## больше; на физику никого не толкает.

func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(other: Node2D) -> void:
	# Смертельно для того, кто умеет умирать (герой). Всё прочее — мимо.
	if other.has_method("die"):
		other.call("die")
