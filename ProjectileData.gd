extends Resource
## Данные ТИПА снаряда: текстура, полёт и урон. Один .tres = один тип снаряда.
##
## Тут только числа/ссылки, никакого поведения: Projectile.gd читает поля отсюда
## и по ним строит картинку и полёт. Флаги группы «Попадание» — тоже данные: по ним
## Projectile.gd выбирает ветку (пробивать врагов, бить по HP башни, сообщать о промахе),
## а по умолчанию все они выключены, то есть камень ведёт себя как раньше.
## Чтобы сделать новый тип снаряда — сохрани копию .tres (в редакторе: Resource → Save As)
## и правь числа/текстуру; если
## нужно особое поведение при попадании — подкласс Projectile.gd с переопределёнными
## _on_hit_enemy() / _on_hit_ground() / _on_expire() (см. док-строку в Projectile.gd).
##
## class_name намеренно НЕ ставим: как у Rig.gd, чтобы не зависеть от кэша
## глобальных классов редактора (в headless-прогоне он может быть не обновлён).
## Тип в Projectile.gd задан через const ProjectileData := preload("res://ProjectileData.gd").

@export_group("Вид")
## Картинка снаряда (камень и т.п.). Пусто — снаряд без картинки.
@export var texture: Texture2D
## Во сколько раз ИСХОДНЫЙ рисунок снаряда больше файла в проекте (исходная ширина / ширина
## файла). Файл не уменьшали — 1.0 (ядро: cannonball.png 63×63 = ровно исходный рисунок).
@export var native_mult: float = 1.0
## Размер снаряда по ЕДИНОМУ МАСШТАБУ АРТА (ArtScale, docs/SETUP.md раздел 16):
## размер в мире = пиксели картинки × ArtScale.hero_scale() × native_mult × size_mult.
## Ядро пушки — 2.0 (вдвое крупнее нарисованного: 63 px → ≈26 px в мире). 0 — снаряд живёт
## по старой схеме art_scale × sprite_scale, то есть размер задаёт тот, кто его бросил
## (так работает камень: 0, поведение не менялось).
@export var size_mult: float = 0.0

@export_group("Полёт")
## Начальная скорость, px/с (направление задаёт игрок: точно на курсор).
@export var speed: float = 900.0
## Гравитация снаряда, px/с²: каждый кадр velocity.y += gravity * delta.
## 0 = летит по прямой, 1400 = заметная дуга, 2200 = как гравитация героя.
@export var gravity: float = 1400.0
## Время жизни, сек.
@export var lifetime: float = 3.0

@export_group("Попадание")
## Урон: снаряд отдаёт его цели через take_hit(damage, direction) (см. Projectile._damage_target),
## поэтому у врага снимается HP, а у башни — нет (она ломается только от apply_damage).
## У ядра пушки 1000 (хватает одного попадания по башне с max_hp 1000).
@export var damage: float = 1.0
## Пробивает врагов (ядро пушки): урон отдаётся каждому, в кого снаряд попал, а сам он летит
## дальше. false — снаряд исчезает на первом же враге (камень, поведение не менялось).
@export var pierce_enemies: bool = false
## Снимает HP башни (Tower.apply_damage). false — попадание в башню только дёргает её корпус
## (Tower.take_hit), HP не меняется (камень, поведение не менялось).
@export var can_damage_tower: bool = false
## Сообщать о промахе сигналом missed: снаряд попал в землю/стену, кончилось время жизни или он
## ушёл за границы экрана. По этому сигналу Cannon объявляет поражение (см. Cannon.gd).
## false — снаряд молчит (камень, поведение не менялось).
@export var report_miss: bool = false
